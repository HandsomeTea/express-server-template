{
    // 使用 IntelliSense 了解相关属性。
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Express App",
            "runtimeExecutable": "npx", // 使用 npx 调用 tsx
            "runtimeArgs": [
                "tsx",
                "watch", // 开启监听模式，类似之前的 --respawn
                "${workspaceRoot}/index.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
