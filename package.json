{
	"name": "express-server-template",
	"version": "1.0.0",
	"description": "快速模版项目",
	"main": "index.js",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=24.15.0"
	},
	"directories": {
		"test": "test"
	},
	"scripts": {
		"dev": "tsx watch index.ts",
		"build": "rimraf dist && tsc",
		"doc": "",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"cover-test": "vitest run --coverage",
		"lint": "biome check --write .",
		"husky-init": "husky init"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/HandsomeTea/express-server-template.git"
	},
	"keywords": [
		"http",
		"server",
		"express"
	],
	"author": "HandsomeTea.coco@gmail.com",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/HandsomeTea/express-server-template/issues"
	},
	"homepage": "https://github.com/HandsomeTea/express-server-template#readme",
	"dependencies": {
		"@godaddy/terminus": "^4.12.1",
		"compression": "^1.8.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.3.2",
		"helmet": "^8.1.0",
		"mongoose": "^9.5.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.1.3",
		"pino-roll": "^4.0.0",
		"rimraf": "^6.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@types/compression": "^1.8.1",
		"@types/express": "^5.0.6",
		"@types/node": "^25.6.0",
		"@types/supertest": "^7.2.0",
		"husky": "^9.1.7",
		"supertest": "^7.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
