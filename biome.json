{
	"$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": ["src/**", "tests/**", "typings/**", "index.ts", "vitest.config.ts"]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useBlockStatements": "error",
				"useNamingConvention": {
					"level": "warn",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": {
									"kind": "objectLiteralProperty"
								},
								"formats": ["camelCase", "CONSTANT_CASE"]
							},
							{
								"selector": {
									"kind": "typeProperty"
								},
								"formats": ["camelCase", "CONSTANT_CASE"]
							}
						]
					}
				}
			},
			"correctness": {
				"noUnusedVariables": {
					"level": "error"
				},
				"noUnusedImports": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "warn"
			},
			"suspicious": {
				"noConsole": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 130,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "none",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["test/**/*.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noStaticOnlyClass": "off"
					},
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
