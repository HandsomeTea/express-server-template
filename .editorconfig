# 表示是最顶层的 EditorConfig 配置文件
root = true
[*] # 表示所有文件适用
charset = utf-8 # 设置文件字符集为 utf-8
indent_style = tab # 缩进风格（tab | space）
indent_size = 4 # 缩进大小
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yaml,yml}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
